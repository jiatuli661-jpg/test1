#include<stdio.h>
int main()
{
    int m,n;
    scanf("%d %d",&m,&n);
    int i;
    int cnt=0;
    for(i=m;i<=n;i++){
        int j=i;
        while(j>0){
            int k=j%10;
            j=j/10;
            if(k==2){
                cnt++;
            }
        }
    }
    printf("%d",cnt);
    return 0;
}