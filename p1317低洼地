#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int a[100000];
    int b[100000];
    int i;
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    int len=0;
    b[len++]=a[0];
    int k;
    for(k=1;k<n;k++){
        if(a[k]!=b[len-1]){
            b[len++]=a[k];
        }
    }
    int cnt=0;
    int j;
    for(j=1;j<len-1;j++){
        if(b[j]<b[j-1]&&b[j]<b[j+1]){
            cnt++;
        }
    }
    printf("%d",cnt);
    return 0;
}