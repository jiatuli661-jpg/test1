#include<stdio.h>
int main()
{
    int n,m;
    scanf("%d %d",&n,&m);
    int i,j;
    int a=0;
    int b=0;
    for(i=1;i<=n;i++){
        for(j=1;j<=m;j++){
            if(i==j){
                a+=(n-i+1)*(m-j+1);
            }else{
                b+=(n-i+1)*(m-j+1);
            }
        }
    }
    printf("%d %d",a,b);
    return 0;
}