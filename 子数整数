#include<stdio.h>
int main()
{
    int k;
    scanf("%d",&k);
    int i,j;
    int a1,a2,a3,a4,a5;
    int s=0;
    for(i=10000;i<=30000;i++){
        a1=i%10;
        a2=i%100/10;
        a3=i%1000/100;
        a4=i/1000%10;
        a5=i/10000;
        int x=a1+a2*10+a3*100;
        int y=a2+a3*10+a4*100;
        int z=a3+a4*10+a5*100;
        if(x%k==0&&y%k==0&&z%k==0){
            printf("%d\n",i);
            s=1;
        }
    }
    if(s==0){
        printf("No");
    }
    return 0;
}