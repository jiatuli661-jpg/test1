#include<stdio.h>
#include<stdlib.h>
int main()
{
    int n;
    scanf("%d",&n);
    int i;
    int a[10000];
    int s=0;
    int flag[100000]={0};
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    int j;
    int b;
    for(j=0;j<n-1;j++){
        b=abs(a[j+1]-a[j]);
        if(b>=n||b<1||flag[b]==1){
            s=1;
            break;
        }
        flag[b]=1;
    }
    if(s==0){
        printf("Jolly");
    }else{
        printf("Not jolly");
    }
    return 0;
}